# Скопируйте этот файл в keystore.properties (в той же папке, рядом с settings.gradle.kts)
# и заполните значениями вашего keystore. Сам keystore.properties НЕ должен попадать
# в систему контроля версий (уже в .gitignore).
#
# Если keystore ещё не создан:
#   Android Studio -> Build -> Generate Signed Bundle / APK... -> Android App Bundle ->
#   Create new... -> укажите путь для .jks файла, придумайте пароли (сохраните их отдельно
#   и надёжно — без них нельзя будет выпустить обновление под тем же applicationId).
#
# storeFile — абсолютный путь к .jks/.keystore файлу, например:
#   D:\\Cardio_ACS\\keystore\\cardioacs-release.jks
storeFile=D:\\Cardio_ACS\\keystore\\cardioacs-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=cardioacs
keyPassword=REPLACE_WITH_KEY_PASSWORD
